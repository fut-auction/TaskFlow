# Local development only. Never commit real API keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PORT=8080
# Optional Firebase cloud mode. Leave blank to use the full guest/local workspace.
# Public web app configuration, not service-account keys.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Optional OpenRouter referer:
PUBLIC_APP_URL=
# Emulator-only settings: use a demo- project; never set these in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
