# Local development only. Never commit real API keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PORT=8080
# Optional Firebase cloud mode. Leave blank to use the full guest/local workspace.
# Public web app configuration, not service-account keys.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Required public origin when enabling production guest AI; also the OpenRouter referer:
PUBLIC_APP_URL=
# Emulator-only settings: use a demo- project; never set these in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Public guest AI is opt-in in production. Unset keeps local development working.
# GUEST_AI_ENABLED=true
# Optional extra comma-separated HTTPS origins:
# GUEST_AI_ALLOWED_ORIGINS=https://your-taskflow-domain.example
# Per-process fixed-window budgets, reset on restart; NOT global Cloud Run limits.
# GUEST_AI_REQUESTS_PER_MINUTE=20
# GUEST_AI_INSTANCE_REQUESTS_PER_MINUTE=60
# GUEST_AI_INSTANCE_REQUESTS_PER_HOUR=120
# GUEST_AI_INSTANCE_REQUESTS_PER_DAY=300
# GUEST_AI_MAX_CONCURRENT=2
# GUEST_AI_MAX_INPUT_BYTES=96000
# GUEST_AI_MAX_OUTPUT_TOKENS=1000
# GUEST_AI_TIMEOUT_MS=30000
# Leave 0 unless the trusted reverse-proxy hop count is verified for your deployment.
# GUEST_AI_TRUST_PROXY_HOPS=0
